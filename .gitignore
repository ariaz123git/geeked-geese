# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# This project
shots/

# Python bytecode from running tools/gen_*.py
__pycache__/
*.pyc

# Claude Code's local session state (lock files, settings); nothing in it is
# part of the project
.claude/

# DO NOT ADD *.uid HERE.
# .uid files are how Godot tracks resource identity across renames. If they are not
# committed, every clone regenerates fresh UIDs and every scene that references a
# script points at a UID that exists only on the original machine.
#
# Also commit: *.import files (they contain import metadata) and export_presets.cfg
# (since Godot 4.1, credentials live in .godot/export_credentials.cfg, not here).

# 90 MB of superseded snapshot zips and three stale .godot caches.
# Kept locally on purpose, but never committed.
_to_delete/
