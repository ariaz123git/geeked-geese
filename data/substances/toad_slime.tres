script = ExtResource("1_sub")
id = &"toad_slime"
display_name = "Toad Slime"
mimics = "Bufotoxin / 5-MeO-DMT"
blurb = "There is a toad by the pond at night. Do not lick the toad. You are going to lick the toad."
codex_fact = "In 2022 the US National Park Service formally asked visitors to 'refrain from licking' the Colorado River toad, whose venom contains 5-MeO-DMT. Canada's own American toad makes bufotoxin instead, which is not psychedelic but does poison dogs every summer — vets treat it as a genuine emergency. Whatever you have licked, the toad did not make it for you."
