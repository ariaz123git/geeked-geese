script = ExtResource("1_sub")
id = &"bread"
display_name = "Bread"
mimics = "Nothing at all, and that is the entire joke."
blurb = "Somebody's nan is throwing it at you. There is a sign asking her not to. She cannot read the sign; she is busy."
codex_fact = "Bread is genuinely bad for waterfowl. It fills a bird up without feeding it, and goslings raised on it can develop angel wing -- a deformity where the last joint of the wing twists outward and the bird never flies. The signs at the pond are not fussing. This is the one thing in the Almanac that is a public-health notice rather than a fun fact."
