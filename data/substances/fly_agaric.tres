script = ExtResource("1_sub")
id = &"fly_agaric"
display_name = "Fly Agaric"
mimics = "Muscimol (Amanita muscaria)"
blurb = "The storybook mushroom. Red cap, white spots. The world will not stop changing size."
codex_fact = "Amanita muscaria is the red-and-white-spotted mushroom from every fairy tale, and its signature effect is not colour but SIZE: macropsia and micropsia, where objects appear far larger or smaller than they are, in waves. That is where Alice's growing and shrinking comes from. It is a deliriant, not a classic psychedelic — and the popular story that Siberian shamans drank reindeer urine to recycle it is far shakier than the internet claims."
