[resource]
script = ExtResource("1_sub")
id = &"catnip"
display_name = "Catnip"
mimics = "Nepetalactone"
blurb = "Somebody's herb garden. Does almost nothing to you. Turns every cat in the lot into artillery."
codex_fact = "Catnip's active compound, nepetalactone, is a better mosquito repellent than DEET at equal concentration — a 2001 American Chemical Society study found it roughly ten times more effective, and a 2021 Northwestern study showed it works by jamming an insect irritant receptor. Only about two thirds of cats respond to catnip at all; the rest are genetically indifferent, which is why one cat in three here will refuse to help you."
