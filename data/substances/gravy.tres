[resource]
script = ExtResource("1_sub")
id = &"gravy"
display_name = "Gravy"
mimics = "Dimenhydrinate (Gravol)"
blurb = "A poutine container that is not poutine. Whatever you start seeing after this, it is not there."
codex_fact = "Dimenhydrinate is the ordinary over-the-counter motion-sickness pill sold in Canada as Gravol. At high doses it stops being an antihistamine and becomes a deliriant: unlike a psychedelic, it produces hallucinations the person genuinely cannot tell from reality — full conversations with people who are not there. It is one of the most commonly misused legal drugs precisely because it is on the shelf beside the bandages."
